      "PlaceRecommendationRequest": {
        "properties": {
          "destination": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional destination filter (e.g. 'ha-noi', 'da-nang', 'ha-long')",
            "example": "da-nang",
            "title": "Destination"
          },
          "model": {
            "default": "rec-a1",
            "description": "Algorithm baseline to use ('rec-a1' for cosine, 'rec-a0' for taxonomy overlap, 'rec-a2' for diversity reranker)",
            "example": "rec-a1",
            "title": "Model",
            "type": "string"
          },
          "preferences": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "User travel preference object containing 'interests', 'travelStyle', etc.",
            "example": {
              "interests": [
                "food_cuisine",
                "culture_history"
              ]
            },
            "title": "Preferences"
          },
          "top_k": {
            "default": 10,
            "description": "Number of recommendations to return",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Top K",
            "type": "integer"
          }
        },
        "title": "PlaceRecommendationRequest",
        "type": "object"
      },
      "PlaceRecommendationResponse": {
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/MetadataDto"
          },
          "recommendations": {
            "items": {
              "$ref": "#/components/schemas/RecommendedPlaceDto"
            },
            "title": "Recommendations",
            "type": "array"
          },
          "unsupported_user_features": {
            "items": {
              "$ref": "#/components/schemas/UnsupportedFeatureDto"
            },
            "title": "Unsupported User Features",
            "type": "array"
          }
        },
        "required": [
          "recommendations",
          "metadata",
          "unsupported_user_features"
        ],
        "title": "PlaceRecommendationResponse",
        "type": "object"
      },
      "PlanRequest": {
        "properties": {
          "budget": {
            "anyOf": [
              {
