          },
          "tool": {
            "title": "Tool",
            "type": "string"
          }
        },
        "required": [
          "tool",
          "args",
          "result"
        ],
        "title": "ToolCallLog",
        "type": "object"
      },
      "TripContextRequest": {
        "properties": {
          "budget": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget"
          },
          "currency": {
            "default": "VND",
            "title": "Currency",
            "type": "string"
          },
          "days": {
            "description": "Duration in days, between 1 and 14",
            "maximum": 14.0,
            "minimum": 1.0,
            "title": "Days",
            "type": "integer"
          },
          "destination": {
            "title": "Destination",
            "type": "string"
          },
          "end_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Date"
          },
          "existing_itinerary_count": {
            "default": 0,
            "title": "Existing Itinerary Count",
