            "items": {
              "type": "string"
            },
            "title": "General Tips",
            "type": "array"
          },
          "overview": {
            "title": "Overview",
            "type": "string"
          },
          "plan_id": {
            "title": "Plan Id",
            "type": "string"
          },
          "total_days": {
            "title": "Total Days",
            "type": "integer"
          }
        },
        "required": [
          "plan_id",
          "destination",
          "total_days",
          "overview",
          "best_time_to_visit",
          "budget_analysis"
        ],
        "title": "PlanResponse",
        "type": "object"
      },
      "RecommendedPlaceDto": {
