          "destination_slug",
          "category",
          "score",
          "rank",
          "matched_interests",
          "explanation",
          "strategy"
        ],
        "title": "RecommendedPlaceDto",
        "type": "object"
      },
      "ToolCallLog": {
        "properties": {
          "args": {
            "additionalProperties": true,
