      "MetadataDto": {
        "properties": {
          "algorithm": {
            "title": "Algorithm",
            "type": "string"
          },
          "cold_start": {
            "title": "Cold Start",
            "type": "boolean"
          },
          "destination_filter": {
            "anyOf": [
