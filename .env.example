# ============================================================================
# GoMate environment template. PLACEHOLDERS ONLY - never commit real secrets.
# Copy to .env (git-ignored). See docs/w3/developer-runbook.md for which
# component reads which variable.
# ============================================================================
# ============ DATABASE ============
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wanderai
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ============ REDIS ============
REDIS_HOST=localhost
REDIS_PORT=6379

# ============ AUTH ============
JWT_SECRET=wanderai-jwt-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=wanderai-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ============ AI SERVICE ============
AI_SERVICE_URL=http://localhost:8000

# ============ LLM ============
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# ============ MEDIA ============
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============ GOOGLE MAPS ============
GOOGLE_MAPS_API_KEY=your-maps-api-key

# ============ WEATHER ============
WEATHER_API_URL=https://api.open-meteo.com/v1

# ============ APP ============
NODE_ENV=development
PORT=3000
AI_PORT=8000

# ============ AI PLANNER (optional, ai-service defaults apply) ============
# PLANNER_MODEL=gemini-3.5-flash
# PLANNER_MAX_OUTPUT_TOKENS=16384
# PLANNER_TIMEOUT_MS=55000
