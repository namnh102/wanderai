      "roadmap_scientific_target": 1.0,
      "roadmap_scientific_target_percentage": 100.0
    },
    "DESTINATION_CORRECTNESS": {
      "dimension_id": "DESTINATION_CORRECTNESS",
      "tier": "PRIMARY_HARD",
      "definition": "For every grounded place_id in the itinerary, the catalog record's destination_slug must equal the requested benchmark scenario destination_slug.",
      "name_string_inference_allowed": false,
      "item_level_metric": {
        "name": "Destination-Correct POI Rate",
        "key": "destination_correct_poi_rate",
        "numerator": "grounded_poi_items_matching_requested_destination",
        "denominator": "grounded_itinerary_poi_items"
      },
      "scenario_level_metric": {
        "name": "scenario_destination_valid",
        "key": "scenario_destination_valid",
        "definition": "true if and only if all POI items are grounded and every grounded POI item belongs to the requested scenario destination."
      }
    },
    "DUPLICATE_POI": {
      "dimension_id": "DUPLICATE_POI",
      "tier": "PRIMARY_HARD",
      "operates_on": "canonical_place_id",
      "free_text_alias_equality_sufficient": false,
      "default_benchmark_policy": "The same canonical place_id must not appear more than once across an entire itinerary unless a future scenario explicitly preregisters revisits as allowed.",
      "metrics": [
        "duplicate_poi_violation_count",
        "duplicate_poi_violation_rate"
      ],
      "scenario_pass_condition": "duplicate_poi_violation_count == 0 (under default no-revisit policy)"
    },
    "SCHEDULE_VALIDITY": {
      "dimension_id": "SCHEDULE_VALIDITY",
      "tier": "PRIMARY_HARD",
      "expected_time_format": "HH:MM",
      "interval_ordering_requirement": "start_time < end_time",
      "intra_day_non_overlap_requirement": "Within the same itinerary day, any two timed activity intervals [start_time_i, end_time_i) and [start_time_j, end_time_j) must not overlap (end_time_earlier <= start_time_later).",
      "violation_categories": [
        "TIME_PARSE_INVALID",
        "TIME_INTERVAL_INVALID",
        "SCHEDULE_OVERLAP"
      ],
      "metric": "schedule_violation_rate",
      "scenario_pass_condition": "Scenario schedule PASS if and only if zero TIME_PARSE_INVALID, zero TIME_INTERVAL_INVALID, and zero SCHEDULE_OVERLAP occur across all days of the itinerary."
