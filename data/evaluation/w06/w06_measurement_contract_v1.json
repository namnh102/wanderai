        "name": "Grounded POI Rate",
        "key": "grounded_poi_rate",
        "numerator": "valid_grounded_itinerary_poi_items",
        "denominator": "all_itinerary_poi_items",
        "formula": "valid_grounded_itinerary_poi_items / all_itinerary_poi_items"
      },
      "scenario_level_metric": {
        "name": "ALL_POIS_GROUNDED",
        "key": "all_pois_grounded",
        "definition": "true if and only if all itinerary POI items in the scenario have valid grounded canonical place_id in the frozen catalog (and itinerary has >= 1 POI item)."
