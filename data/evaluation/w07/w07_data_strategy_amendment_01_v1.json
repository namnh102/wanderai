  "strategy_transition": {
    "old_strategy": "POI-grounded review corpus -> retrieval -> RAG review summarization",
    "new_strategy": "canonical POI knowledge corpus -> retrieval -> grounded POI RAG",
    "amendment_rationale": "W07-A4P investigated 18 public sources comprising 300,536 raw rows and 186,170 unique public reviews, but zero reviews satisfied the combined frozen requirements for clear academic reuse/provenance and high-confidence mapping to the 60 canonical POIs in Hà Nội, Đà Nẵng, and Hạ Long. Continuing broad public-review acquisition has diminishing scientific value. Meanwhile, first-party review collection (W07-A3 Google Forms and W07-A4H Assisted Collection) remains scientifically valid, but human contributor recruitment volume cannot be made a blocking gate for the core W07 retrieval and RAG thesis experiments. Amending the primary W07 corpus to an evidence-grounded canonical POI knowledge corpus preserves strict provenance, avoids fabricated or AI-generated reviews, avoids unauthorized commercial scraping, and enables rigorous offline evaluation of BM25, Dense, and Hybrid RRF retrieval and grounded RAG citation.",
    "avoids_prohibited_shortcuts": [
      "No fabricated review data",
      "No AI-generated review augmentation",
      "No unauthorized commercial platform scraping",
      "No lowering of provenance or entity-mapping standards"
    ]
  },
